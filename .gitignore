```gitignore
# Compiled and build artifacts
*.exe
*.dll
*.so
*.a
*.obj
*.out
*.class
*.pyc
__pycache__/

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build directories
dist/
build/
target/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# Editors
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db
*.log
*.tmp

# Gradle
.gradle/
```